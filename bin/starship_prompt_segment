#!/bin/sh
set -eu

path=$PWD
case $path in
    "$HOME") path='' ;;
    "$HOME"/*) path="/${path#"$HOME"/}" ;;
esac

case $path in
    */*/*/*)
        current=${path##*/}
        path=${path%/*}
        second=${path##*/}
        path=${path%/*}
        first=${path##*/}
        path="/$first/$second/$current"
        ;;
esac

flags=
if [ ! -w "$PWD" ]; then
    flags=''
fi
if [ "${STARSHIP_JOBS:-0}" -gt 0 ]; then
    flags="${flags:+$flags  } $STARSHIP_JOBS"
fi
status=${STARSHIP_CMD_STATUS:-0}

case ${1:-} in
    parent)
        [ "$path" != / ] && [ "${path#*/}" != "$path" ] || exit 0
        parent=${path%/*}
        if [ -z "$parent" ]; then
            printf '/'
        else
            while [ "${parent#*/}" != "$parent" ]; do
                printf '%s  ' "${parent%%/*}"
                parent=${parent#*/}
            done
            printf '%s' "$parent"
        fi
        printf ' '
        ;;
    current)
        if [ "$path" = / ]; then
            printf '/'
        else
            printf '%s' "${path##*/}"
        fi
        ;;
    flags)
        [ -n "$flags" ] && printf '%s' "$flags"
        ;;
    error-after-flags)
        [ "$status" -ne 0 ] && [ -n "$flags" ] && printf '%s' "$status"
        ;;
    error)
        [ "$status" -ne 0 ] && [ -z "$flags" ] && printf '%s' "$status"
        ;;
    end-after-flags)
        [ "$status" -eq 0 ] && [ -n "$flags" ] && printf ''
        ;;
    end)
        [ "$status" -eq 0 ] && [ -z "$flags" ] && printf ''
        ;;
    *) exit 2 ;;
esac
