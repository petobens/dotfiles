#!/usr/bin/env bash
set -euo pipefail

# Start a read-only Postgres MCP server for the Mutt database through the SSM
# tunnel. Credentials are read from pass at launch, so no agent configuration
# stores them. The bare URI makes Postgres take every connection setting from
# the PG* variables, so special characters in the password need no URL escaping
repo=$(dirname "$(dirname "$(readlink -f "$0")")")
DATABASE_URI=postgresql:// exec "$repo/bin/mutt_pg_tunnel" --lazy \
    "$(uv tool dir)/postgres-mcp/bin/python" "$repo/config/postgres-mcp/launcher.py" \
    "$repo/bin/mutt_pg_tunnel" --access-mode=restricted
