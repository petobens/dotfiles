#!/usr/bin/env python3
"""Prune Claude Code and Codex agent session files.

Deletes old sessions and small single-exchange sessions. Pass --all to delete
every session. Run with -n/--dry-run to preview.
"""

import argparse
import json
import re
import shutil
import time
from pathlib import Path

AGE_DAYS = 60
MIN_USER_PROMPTS = 2  # keep sessions with at least this many user prompts
MAX_SINGLE_EXCHANGE_TEXT_SIZE = 128 * 1024
MIN_SINGLE_EXCHANGE_AGE = 60 * 60

CLAUDE_ROOT = Path.home() / ".claude" / "projects"
CODEX_ROOT = Path.home() / ".codex" / "sessions"
UUID_RE = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")


def session_stats(path: Path, adapter: str) -> tuple[int, int]:
    """Count human prompts and visible message bytes, excluding session metadata."""
    prompts = text_size = 0
    codex_paginated = False
    try:
        with path.open(errors="ignore") as fh:
            for line in fh:
                try:
                    d = json.loads(line)
                except json.JSONDecodeError:
                    continue

                if adapter == "claude":
                    role = d.get("type")
                    content = d.get("message", {}).get("content", "")
                    if isinstance(content, list):
                        content = "".join(
                            part.get("text", "")
                            for part in content
                            if isinstance(part, dict) and part.get("type") == "text"
                        )
                else:
                    payload = d.get("payload", {})
                    if d.get("type") == "session_meta":
                        codex_paginated = payload.get("history_mode") == "paginated"
                    if codex_paginated:
                        role = (
                            payload.get("role")
                            if payload.get("type") == "message"
                            else None
                        )
                        kinds = payload.get(
                            "internal_chat_message_metadata_passthrough", {}
                        ).get("content_item_kinds", [])
                        if (
                            role == "user"
                            and kinds
                            and not any(kind.startswith("user.") for kind in kinds)
                        ):
                            role = None
                        content = "".join(
                            part.get("text", "")
                            for part in payload.get("content", [])
                            if isinstance(part, dict)
                            and part.get("type") in {"input_text", "output_text"}
                        )
                    else:
                        role = {
                            "user_message": "user",
                            "agent_message": "assistant",
                        }.get(payload.get("type"))
                        content = payload.get("message", "")

                if (
                    role not in {"user", "assistant"}
                    or not isinstance(content, str)
                    or not content
                ):
                    continue
                if role == "user":
                    prompts += 1
                text_size += len(content.encode())
                if prompts >= MIN_USER_PROMPTS:
                    return prompts, text_size
    except OSError:
        pass
    return prompts, text_size


def remove_session_dirs(root: Path, dry_run: bool) -> int:
    """Remove Claude session artifact directories below a session root."""
    removed = 0
    for path in root.glob("*/*"):
        if not path.is_dir() or not UUID_RE.match(path.name):
            continue
        if not dry_run:
            shutil.rmtree(path)
        removed += 1
    return removed


def remove_empty_dirs(root: Path, dry_run: bool) -> int:
    """Remove empty directories below a session root."""
    removed = 0
    for current, _dirs, _files in root.walk(top_down=False):
        if current == root:
            continue
        try:
            if any(current.iterdir()):
                continue
            if not dry_run:
                current.rmdir()
            removed += 1
        except OSError:
            pass
    return removed


def prune(
    name: str,
    files: list[Path],
    cutoff: float,
    single_exchange_cutoff: float,
    dry_run: bool,
    delete_all: bool,
) -> int:
    """Delete matching session files and report the result."""
    old = small = kept = 0
    for f in files:
        if delete_all:
            old += 1
            if not dry_run:
                f.unlink()
            continue

        try:
            stat = f.stat()
        except OSError:
            continue
        is_old = stat.st_mtime < cutoff
        is_small_single_exchange = False
        if not is_old and stat.st_mtime < single_exchange_cutoff:
            prompts, text_size = session_stats(f, name)
            is_small_single_exchange = (
                prompts < MIN_USER_PROMPTS and text_size < MAX_SINGLE_EXCHANGE_TEXT_SIZE
            )
        if is_old or is_small_single_exchange:
            if is_old:
                old += 1
            else:
                small += 1
            if not dry_run:
                f.unlink()
        else:
            kept += 1
    verb = "would delete" if dry_run else "deleted"
    detail = "all" if delete_all else f"old={old}, small-single-exchange={small}"
    print(f"{name:<6}: {verb} {old + small} ({detail}), kept {kept}")
    return old + small


def confirm_delete_all() -> bool:
    """Ask for confirmation before deleting every session."""
    answer = input("Delete all Claude and Codex sessions? Type 'yes' to continue: ")
    return answer == "yes"


def main() -> None:
    """Parse CLI arguments and prune agent sessions."""
    ap = argparse.ArgumentParser(description=__doc__)
    ap.add_argument(
        "-n", "--dry-run", action="store_true", help="preview, delete nothing"
    )
    ap.add_argument("--all", action="store_true", help="delete every session")
    args = ap.parse_args()

    if args.all and not args.dry_run and not confirm_delete_all():
        print("aborted")
        return

    now = time.time()
    cutoff = now - AGE_DAYS * 86400
    single_exchange_cutoff = now - MIN_SINGLE_EXCHANGE_AGE
    total = prune(
        "claude",
        list(CLAUDE_ROOT.glob("**/*.jsonl")),
        cutoff,
        single_exchange_cutoff,
        args.dry_run,
        args.all,
    )
    total += prune(
        "codex",
        list(CODEX_ROOT.glob("**/rollout-*.jsonl")),
        cutoff,
        single_exchange_cutoff,
        args.dry_run,
        args.all,
    )
    empty_dirs = 0
    if args.all:
        session_dirs = remove_session_dirs(CLAUDE_ROOT, args.dry_run)
        empty_dirs += remove_empty_dirs(CLAUDE_ROOT, args.dry_run)
        empty_dirs += remove_empty_dirs(CODEX_ROOT, args.dry_run)
    verb = "would delete" if args.dry_run else "deleted"
    print(f"total: {verb} {total}")
    if args.all:
        dir_verb = "would remove" if args.dry_run else "removed"
        print(f"session dirs: {dir_verb} {session_dirs}")
        print(f"empty dirs: {dir_verb} {empty_dirs}")


if __name__ == "__main__":
    main()
