#!/usr/bin/env bash

pid_file="$XDG_RUNTIME_DIR/${0##*/}.pid"

# Close an existing menu instead of opening a second copy
if [[ -r $pid_file ]]; then
    pid=$(< "$pid_file")
    if [[ $pid =~ ^[1-9][0-9]*$ ]] && kill "$pid" 2> /dev/null; then
        rm -f "$pid_file"
        exit 0
    fi
    rm -f "$pid_file"
fi

rofi() {
    local status=0
    # Keep Rofi alive until a repeated Waybar click reaches this toggle
    command rofi -no-click-to-exit -pid "$pid_file" "$@" || status=$?
    rm -f "$pid_file"
    return "$status"
}
