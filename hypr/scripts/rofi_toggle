#!/usr/bin/env bash

pid_file="$XDG_RUNTIME_DIR/${0##*/}.pid"

# Close a live menu or absorb the click that just dismissed it
if [[ -r $pid_file ]]; then
    pid=$(< "$pid_file")
    if [[ $pid =~ ^[1-9][0-9]*$ ]]; then
        kill "$pid" 2> /dev/null || true
    fi
    rm -f "$pid_file"
    exit 0
fi

rofi() {
    local status=0
    command rofi -pid "$pid_file" "$@" || status=$?
    # Keep the marker until Waybar finishes forwarding the outside click
    sleep 0.25
    rm -f "$pid_file"
    return "$status"
}
