#!/usr/bin/env bash
set -euo pipefail

# The menu contains entry names, not secrets
entry=$(gopass ls --flat | rofi -dmenu -p 'password')
[[ -n $entry ]] || exit 0

marker="${XDG_RUNTIME_DIR:?}/cliphist-ignore"
secret=$(gopass show -o "$entry")
digest=$(printf '%s' "$secret" | sha256sum)
record="$$-$RANDOM ${digest%% *}"
trap 'rm -f "$marker"' EXIT
printf '%s\n' "$record" > "$marker"
printf '%s' "$secret" | wl-copy
trap - EXIT

# Clear only if the password is still the current clipboard value
(
    sleep 45
    if [[ -e $marker && $(< "$marker") == "$record" ]]; then
        [[ $(wl-paste --no-newline 2> /dev/null) == "$secret" ]] && wl-copy --clear
        rm -f "$marker"
    fi
) > /dev/null 2>&1 &
unset secret digest record

notify-send -t 2000 'Password copied' "$entry"
