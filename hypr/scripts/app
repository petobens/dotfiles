#!/usr/bin/env bash
set -euo pipefail

cycle=false

if [[ ${1:-} == menu ]]; then
    app=$(
        printf '%s\n' \
            about audio bluetooth brave calendar clickup docker edge files gmail \
            htop images meet numbers onedrive onlyoffice quickterm slack spotify \
            teams terminal transmission trash wifi zathura zoom |
            rofi -dmenu -p 'app'
    )
    [[ -n $app ]] || exit 0
    exec "$0" "$app"
fi

# Resolve the requested app's launch and matching rules
case ${1:-} in
    about)
        tag=about
        class='^about$'
        workspace=current
        command="ghostty --class=about --title='About Arch' -e sh -c 'fastfetch; read -r _'"
        ;;
    audio)
        tag=audio
        class='^(hyprpwcenter|org.hyprland.hyprpwcenter)$'
        workspace=current
        command='hyprpwcenter'
        ;;
    bluetooth)
        tag=bluetooth
        class='^bluetooth$'
        workspace=current
        command='ghostty --class=bluetooth --title=bluetooth -e fish -c bt'
        ;;
    brave)
        tag=brave
        class='^brave-browser$'
        workspace=1
        command='brave'
        ;;
    calendar)
        tag=calendar
        class='^brave-calendar$'
        workspace=1
        command='brave --class=brave-calendar --new-window --app=https://calendar.google.com/calendar/b/0/r'
        ;;
    clickup)
        tag=clickup
        class='^edge-clickup$'
        workspace=1
        command='microsoft-edge-dev --class=edge-clickup --new-window --app=https://app.clickup.com'
        ;;
    docker)
        tag=docker
        class='^docker-info$'
        workspace=current
        command="ghostty --class=docker-info --title=docker-info -e sh -c 'docker info | less +F'"
        ;;
    edge)
        tag=edge
        class='^microsoft-edge-dev$'
        workspace=1
        command='microsoft-edge-dev'
        ;;
    files)
        tag=files
        class='^yazi$'
        workspace=current
        working_directory=$(tmux display -p '#{pane_current_path}' 2> /dev/null || printf '%s' "$HOME")
        command="ghostty --class=yazi --title=yazi --working-directory=\"$working_directory\" -e yazi"
        ;;
    gmail)
        tag=gmail
        class='^brave-gmail$'
        workspace=2
        command='brave --class=brave-gmail --new-window --app=https://mail.google.com'
        ;;
    htop)
        tag=htop
        class='^htop$'
        workspace=current
        command='ghostty --class=htop --title=htop -e htop'
        ;;
    images)
        tag=images
        class='^imv$'
        workspace=current
        command='imv ~/Pictures'
        cycle=true
        ;;
    meet)
        tag=meet
        class='^brave-meet$'
        workspace=2
        command='brave --class=brave-meet --new-window --app=https://meet.google.com'
        ;;
    numbers)
        tag=numbers
        class='^numbers$'
        workspace=current
        command='ghostty --class=numbers --title=numbers -e ipython'
        ;;
    onedrive)
        tag=onedrive
        class='^onedrive$'
        workspace=current
        command='ghostty --class=onedrive --title=OneDrive -e journalctl --user-unit onedrive -f'
        ;;
    onlyoffice)
        tag=onlyoffice
        class='^(DesktopEditors|ONLYOFFICE)$'
        workspace=4
        command='onlyoffice-desktopeditors'
        ;;
    quickterm)
        tag=quickterm
        class='^quickterm$'
        workspace=current
        working_directory=$(tmux display -p '#{pane_current_path}' 2> /dev/null || printf '%s' "$HOME")
        command="ghostty --class=quickterm --title=QuickTerm --working-directory=\"$working_directory\""
        ;;
    slack)
        tag=slack
        class='^Slack$'
        workspace=2
        command='slack --enable-features=UseOzonePlatform --ozone-platform=wayland'
        ;;
    spotify)
        tag=spotify
        class='^Spotify$'
        workspace=3
        command='spotify --enable-features=UseOzonePlatform --ozone-platform=wayland'
        ;;
    teams)
        tag=teams
        class='^brave-teams$'
        workspace=2
        command='brave --class=brave-teams --new-window --app=https://teams.live.com'
        ;;
    terminal)
        tag=terminal
        class='^terminal$'
        workspace=5
        command='ghostty --class=terminal -e fish -l -c tm'
        ;;
    transmission)
        tag=transmission
        class='^transmission-gtk$'
        workspace=4
        command='transmission-gtk'
        ;;
    trash)
        tag=trash
        class='^trash$'
        workspace=current
        command="ghostty --class=trash --title='Trash Can' -e sh -c 'trash-list | less'"
        ;;
    wifi)
        tag=wifi
        class='^nmtui$'
        workspace=current
        command='ghostty --class=nmtui --title=nmtui -e nmtui'
        ;;
    zathura)
        tag=zathura
        class='^org.pwmt.zathura$'
        workspace=current
        command='zathura'
        cycle=true
        ;;
    zoom)
        tag=zoom
        class='^zoom$'
        workspace=2
        command='zoom'
        ;;
    *)
        echo 'usage: app APPLICATION' >&2
        exit 2
        ;;
esac

if [[ $workspace == current ]]; then
    workspace=$(hyprctl activeworkspace -j | jq -r '.id')
fi

# Focus a matching window or launch the app on its assigned workspace
# Tags distinguish browser apps that otherwise share the same process class
mapfile -t addresses < <(
    hyprctl clients -j | jq -r --arg class "$class" --arg tag "$tag" \
        '.[] | select(any(.tags[]?; . == $tag or . == ($tag + "*")) or ((.class // "") | test($class; "i"))) | .address'
)
if ((${#addresses[@]})); then
    address=${addresses[0]}
    if $cycle && ((${#addresses[@]} > 1)); then
        active=$(hyprctl activewindow -j | jq -r '.address')
        for i in "${!addresses[@]}"; do
            if [[ ${addresses[$i]} == "$active" ]]; then
                address=${addresses[$(((i + 1) % ${#addresses[@]}))]}
                break
            fi
        done
    fi
    hyprctl dispatch "hl.dsp.focus({ window = 'address:$address' })"
else
    hyprctl dispatch "hl.dsp.exec_cmd([[$command]], { workspace = '$workspace', tag = '+$tag' })"
fi
