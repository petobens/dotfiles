#!/usr/bin/env bash
set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")

"$script_dir/confirm" 'Do you want to empty the trash?' || exit 0

trash_window=$(hyprctl clients -j | jq -r \
    'first(.[] | select(any(.tags[]?; . == "trash" or . == "trash*"))).address // empty')
if [[ -n $trash_window ]]; then
    hyprctl dispatch \
        "hl.dsp.send_shortcut({ mods = '', key = 'Q', window = 'address:$trash_window' })"
    while hyprctl clients -j | jq -e --arg address "$trash_window" \
        'any(.[]; .address == $address)' > /dev/null; do
        sleep 0.05
    done
fi

trash-empty -f
"$script_dir/raise_or_launch" trash
notify-send -t 2500 -i user-trash 'Trash emptied'
