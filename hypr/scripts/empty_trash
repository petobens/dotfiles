#!/usr/bin/env bash
set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")

"$script_dir/confirm" 'Do you want to empty the trash?' || exit 0

trash_view_open() {
    hyprctl clients -j | jq -e \
        'any(.[]; any(.tags[]?; . == "trash" or . == "trash*"))' > /dev/null
}

if trash_view_open; then
    hyprctl dispatch \
        "hl.dsp.send_shortcut({ mods = '', key = 'Q', window = 'tag:trash' })"
    while trash_view_open; do
        sleep 0.05
    done
fi

trash-empty -f
"$script_dir/raise_or_launch" trash
notify-send -t 2500 -i user-trash 'Trash emptied'
