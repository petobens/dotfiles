#!/usr/bin/env bash
set -euo pipefail

# Warn while the battery drains and suspend before it dies
interval=60
low=20
critical=10
action=5

shopt -s nullglob
batteries=(/sys/class/power_supply/BAT*)
((${#batteries[@]})) || exit 0
battery=${batteries[0]}

# Highest threshold already announced during the current discharge
announced=100

while sleep "$interval"; do
    capacity=$(< "$battery/capacity")
    if [[ $(< "$battery/status") != Discharging ]]; then
        announced=100
        continue
    fi

    if ((capacity <= action && announced > action)); then
        announced=$action
        notify-send -u critical -i battery-caution 'Battery critically low' \
            "Suspending at $capacity%"
        sleep 5
        systemctl suspend
    elif ((capacity <= critical && announced > critical)); then
        announced=$critical
        notify-send -u critical -t 0 -i battery-caution 'Battery critically low' \
            "$capacity% remaining"
    elif ((capacity <= low && announced > low)); then
        announced=$low
        notify-send -i battery-low 'Battery low' "$capacity% remaining"
    fi
done
