#!/usr/bin/env bash
set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
theme="$script_dir/../../config/rofi/device.rasi"

fail() {
    notify-send -u critical -i network-wireless-offline 'Wi-Fi' "$1"
    exit 1
}

# Substitute sample command output in VMs without a Wi-Fi radio
if systemd-detect-virt --vm --quiet &&
    ! command nmcli --terse --fields TYPE device status 2> /dev/null |
    grep -qx wifi; then
    nmcli() {
        case $* in
            'radio wifi') printf 'enabled\n' ;;
            *'device wifi list'*)
                printf '%s\n' '*:90:WPA2:wlan0:VM Network' \
                    ':65:--:wlan0:VM Guest' ':30:WPA2:wlan0:VM Test'
                ;;
        esac
    }
fi

# Waybar status
if [[ ${1:-} == --status ]]; then
    signal=$(nmcli --colors no --terse --fields IN-USE,SIGNAL \
        device wifi list --rescan no | awk -F: '$1 == "*" { print $2; exit }')
    if [[ -n $signal ]]; then
        jq -cn --arg text "$signal%" --argjson percentage "$signal" \
            '{text: $text, percentage: $percentage, alt: "connected", class: "connected"}'
    else
        printf '%s\n' '{"text":"","alt":"disconnected","class":"disconnected"}'
    fi
    exit 0
fi

# Enable the radio if needed
if [[ $(nmcli radio wifi) != enabled ]]; then
    choice=$(printf '󰖩  Enable Wi-Fi\n' |
        rofi -dmenu -no-custom -format i -p 'Wi-Fi' -theme "$theme") || exit 0
    [[ $choice == 0 ]] || exit 0
    nmcli radio wifi on || fail 'Could not enable Wi-Fi'
fi

# Stream scan results into the open menu
list_networks() {
    # Keep the connected reading from before the scan, which briefly changes it
    connected=$(nmcli --colors no --terse --escape no \
        --fields IN-USE,SIGNAL,SECURITY,DEVICE,SSID device wifi list --rescan no |
        awk '/^\*/ { print; exit }')
    IFS=: read -r _ connected_signal _ connected_device connected_ssid <<< "$connected"

    if ! scan=$(nmcli --colors no --terse --escape no \
        --fields IN-USE,SIGNAL,SECURITY,DEVICE,SSID device wifi list --rescan yes); then
        fail 'Could not list networks'
    fi

    ssids=()
    while IFS=: read -r active signal security device ssid; do
        [[ -n $ssid ]] || continue

        # Connected entries sort first, so duplicate names keep the active access point
        duplicate=false
        for known_ssid in "${ssids[@]}"; do
            if [[ $known_ssid == "$ssid" ]]; then
                duplicate=true
                break
            fi
        done
        $duplicate && continue

        if [[ $active == '*' && $device == "$connected_device" && $ssid == "$connected_ssid" ]]; then
            signal=$connected_signal
        fi

        case $signal in
            100 | 9[0-9] | 8[0-9] | 7[5-9]) icon=󰤨 ;;
            7[0-4] | 6[0-9] | 5[0-9]) icon=󰤥 ;;
            4[0-9] | 3[0-9] | 2[5-9]) icon=󰤢 ;;
            *) icon=󰤟 ;;
        esac

        security_label="󰌾 $security"
        [[ -n $security && $security != -- ]] || security_label='󰿆 Open'
        name=$ssid
        [[ $active != '*' ]] || name="$ssid ●"

        # NUL-separated fields preserve network names independently of the columns
        printf '%s\0' "$ssid" "$security" "$device" "$active" >> "$choices_file"
        printf '%s\t%s %d%%\t%s\n' "$name" "$icon" "$signal" "$security_label" 2> /dev/null || return 0
        ssids+=("$ssid")
    done < <(printf '%s\n' "$scan" | sort -t: -k1,1r -k2,2nr)
    ((${#ssids[@]})) || fail 'No networks found'
}

choices_file=$(mktemp)
trap 'rm -f "$choices_file"' EXIT
# Rofi's -no-custom forces synchronous input; validate the selected index below
index=$(list_networks |
    rofi -dmenu -i -no-auto-select -format i \
        -p 'Wi-Fi' -theme "$theme" \
        -theme-str 'window { width: 60ch; } element-text { tab-stops: [ 240px, 336px ]; }') || exit 0
[[ $index =~ ^[0-9]+$ ]] || exit 0
mapfile -d '' -t choice < "$choices_file"
((index < ${#choice[@]} / 4)) || exit 0
ssid=${choice[index * 4]}
security=${choice[index * 4 + 1]}
device=${choice[index * 4 + 2]}
active=${choice[index * 4 + 3]}

# Disconnect the current network or connect to the selection
if [[ $active == '*' ]]; then
    if ! output=$(nmcli --wait 30 device down "$device" 2>&1); then
        fail "$output"
    fi
    notify-send -t 2000 -i network-wireless-offline 'Wi-Fi disconnected' "$ssid"
    exit 0
fi

saved_uuid=
while IFS=: read -r uuid type; do
    [[ $type == 802-11-wireless ]] || continue
    profile_ssid=$(nmcli --escape no --get-values 802-11-wireless.ssid \
        connection show uuid "$uuid")
    if [[ $profile_ssid == "$ssid" ]]; then
        saved_uuid=$uuid
        break
    fi
done < <(nmcli --terse --escape no --fields UUID,TYPE connection show)

if [[ -n $saved_uuid ]]; then
    if ! output=$(nmcli --wait 30 connection up uuid "$saved_uuid" 2>&1); then
        fail "$output"
    fi
elif [[ -z $security || $security == -- ]]; then
    if ! output=$(nmcli --wait 30 device wifi connect "$ssid" 2>&1); then
        fail "$output"
    fi
else
    password=$(rofi -dmenu -password -p "Password for $ssid" \
        -theme "$theme" \
        -theme-str 'entry { placeholder: "Enter password"; }') || exit 0
    [[ -n $password ]] || exit 0
    if ! output=$(nmcli --wait 30 device wifi connect "$ssid" \
        password "$password" 2>&1); then
        fail "$output"
    fi
fi

notify-send -t 2000 -i network-wireless 'Wi-Fi connected' "$ssid"
