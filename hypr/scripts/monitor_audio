#!/usr/bin/env bash
set -euo pipefail

# Make the ARZOPA monitor speakers the default audio output. monitors.lua runs
# this when the lid closes with the ARZOPA and G7 connected.

# Hyprland can detect the display before PipeWire adds its audio output, so
# retry for up to 10 seconds
for ((attempt = 0; attempt < 20; attempt++)); do
    if sinks=$(pactl -f json list sinks); then
        # Keep connected Bluetooth headphones as the default
        if jq -e 'any(.[].name; startswith("bluez_output."))' <<< "$sinks" > /dev/null; then
            exit 0
        fi
        sink=$(jq -r '.[] | select(.properties["alsa.name"] == "ARZOPA") | .name' <<< "$sinks")
        if [[ -n $sink ]] && pactl set-default-sink "$sink"; then
            exit 0
        fi
    fi
    sleep 0.5
done
