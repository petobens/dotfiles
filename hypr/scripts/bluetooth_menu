#!/usr/bin/env bash
set -euo pipefail

script_dir=$(dirname "$(realpath "$0")")
theme="$script_dir/../../config/rofi/device.rasi"

btctl() {
    bluetoothctl "$@" 2>&1
}

fail() {
    notify-send -u critical -i bluetooth-disabled 'Bluetooth' "$1"
    exit 1
}

pair_device() (
    # BlueZ skips agent registration when a command is passed on the command line
    coproc PAIR { exec bluetoothctl --agent NoInputNoOutput 2>&1; }
    pid=$PAIR_PID
    input=${PAIR[1]}
    output=${PAIR[0]}
    trap 'kill "$pid" 2>/dev/null || :; wait "$pid" 2>/dev/null || :' EXIT

    deadline=$((SECONDS + 30))
    while ((SECONDS < deadline)) &&
        IFS= read -r -t "$((deadline - SECONDS))" -u "$output" line; do
        case $line in
            *'Agent registered'*) printf 'pair %s\n' "$1" >&"$input" ;;
            *'Pairing successful'*) return 0 ;;
            *'Request confirmation'* | *'Request authorization'*)
                answer=$(printf 'Accept pairing\nCancel\n' |
                    rofi -dmenu -no-custom -format i -p "$name" \
                        -theme "$theme") || return 1
                [[ $answer == 0 ]] || return 1
                printf 'yes\n' >&"$input"
                ;;
            *'Request PIN code'* | *'Request passkey'*)
                printf 'Pairing requires a passkey. Use interactive bluetoothctl.\n'
                return 1
                ;;
            *'Failed'* | *'not available'*)
                printf '%s\n' "$line"
                return 1
                ;;
        esac
    done
    printf 'Pairing did not complete. Put the device in pairing mode and retry.\n'
    return 1
)

# Substitute sample command output in VMs without a Bluetooth controller
if ! compgen -G '/sys/class/bluetooth/hci*' > /dev/null; then
    systemd-detect-virt --vm --quiet || fail 'No Bluetooth controller found'
    btctl() {
        case $* in
            show) printf 'Controller 00:00:00:00:00:00 VM Bluetooth\nPowered: yes\n' ;;
            'devices Connected')
                printf 'Device 00:00:00:00:00:01 VM Headphones\n'
                ;;
            'devices Paired')
                printf '%s\n' \
                    'Device 00:00:00:00:00:01 VM Headphones' \
                    'Device 00:00:00:00:00:02 VM Keyboard'
                ;;
            devices)
                printf '%s\n' \
                    'Device 00:00:00:00:00:01 VM Headphones' \
                    'Device 00:00:00:00:00:02 VM Keyboard' \
                    'Device 00:00:00:00:00:03 VM Speaker'
                ;;
            'info 00:00:00:00:00:01')
                printf 'Connected: yes\nBattery Percentage: 0x50 (80)\n'
                ;;
            info\ *) printf 'Connected: yes\n' ;;
        esac
    }
    pair_device() { :; }
fi

# Enable the controller if needed
controller=$(btctl show) || fail 'No Bluetooth controller found'
grep -q '^Controller ' <<< "$controller" || fail 'No Bluetooth controller found'
if [[ $(awk '/Powered:/ { print $2; exit }' <<< "$controller") != yes ]]; then
    choice=$(printf '󰂯  Enable Bluetooth\n' |
        rofi -dmenu -no-custom -format i -p 'Bluetooth' \
            -theme "$theme") || exit 0
    [[ $choice == 0 ]] || exit 0
    btctl power on > /dev/null || fail 'Could not enable Bluetooth'
    exec "$0"
fi

# Build the list with scan first, followed by connected, paired, and other devices
rows=('󰂰  Scan for devices')
macs=('')
names=('')
states=(Scan)

add_devices() {
    local state=$1 filter=$2 devices _ mac name known_mac duplicate marker battery label row status_icon
    case $state in
        Connected) status_icon=󰂱 ;;
        Paired) status_icon=󰌷 ;;
        Available) status_icon=󰂯 ;;
    esac
    if [[ -n $filter ]]; then
        devices=$(btctl devices "$filter")
    else
        devices=$(btctl devices)
    fi
    while read -r _ mac name; do
        [[ -n ${mac:-} && -n ${name:-} ]] || continue
        duplicate=false
        for known_mac in "${macs[@]}"; do
            if [[ $known_mac == "$mac" ]]; then
                duplicate=true
                break
            fi
        done
        $duplicate && continue

        marker=
        [[ $state == Connected ]] && marker=' <span foreground="#98c379" size="75%" rise="2048"></span>'
        battery=$(btctl info "$mac" |
            awk '/Battery Percentage:/ { gsub(/[()]/, "", $4); print $4; exit }') ||
            battery=
        # Keep long device names from pushing the battery and status off the menu
        label=$name
        ((${#label} <= 18)) || label="${label:0:17}…"
        label=${label//&/\&amp;}
        label=${label//</\&lt;}
        label=${label//>/\&gt;}
        printf -v row '%s%s\t%s %s\t%s' \
            "$label" "$marker" "$status_icon" "$state" "${battery:+󰁹 $battery%}"
        rows+=("$row")
        macs+=("$mac")
        names+=("$name")
        states+=("$state")
    done <<< "$devices"
}

add_devices Connected Connected
add_devices Paired Paired
add_devices Available ''

# Enter selects an action; Ctrl+i requests device details
menu_status=0
index=$(
    printf '%s\n' "${rows[@]}" | rofi -dmenu -i -no-custom -markup-rows -format i -p 'Bluetooth' \
        -kb-custom-1 'Control+i' \
        -theme "$theme" \
        -theme-str 'window { width: 52ch; }
            inputbar { children: [ prompt, textbox-prompt-colon, entry, num-filtered-rows, textbox-num-sep, num-rows ]; }
            element-text { tab-stops: [ 176px, 308px ]; }'
) || menu_status=$?
[[ $menu_status == 0 || $menu_status == 10 ]] || exit 0
[[ $index =~ ^[0-9]+$ ]] || exit 0
((index < ${#rows[@]})) || exit 0

mac=${macs[index]}
state=${states[index]}
# Show device details, then return to the list
if [[ $menu_status == 10 ]]; then
    [[ $state != Scan ]] || exec "$0"
    info=$(btctl info "$mac") || fail 'Could not read device details'
    details=$(printf 'Device\t%s\nAddress\t%s\n' "${names[index]}" "$mac")
    details+=$'\n'$(printf '%s\n' "$info" | awk '
        /^[[:space:]]*(Connected|Paired|Bonded|Trusted|Blocked|Icon|RSSI|Battery Percentage):/ {
            sub(/^[[:space:]]*/, "")
            sub(/:[[:space:]]*/, "\t")
            print
        }
    ')
    printf '%s\n' "$details" | rofi -dmenu -i -no-custom -p 'Bluetooth info' \
        -theme "$theme" -theme-str 'window { width: 48ch; }
            element-text { tab-stops: [ 160px ]; }' > /dev/null || true
    exec "$0"
fi

if [[ $state == Scan ]]; then
    notify-send -t 1500 -i bluetooth 'Bluetooth' 'Scanning for devices...'
    btctl --timeout 8 scan on > /dev/null || fail 'Device scan failed'
    exec "$0"
fi

# Disconnect connected devices, or pair and connect the selection
name=${names[index]}
if [[ $state == Connected ]]; then
    if ! output=$(btctl disconnect "$mac"); then
        fail "${output:-Could not disconnect $name}"
    fi
    notify-send -t 2000 -i bluetooth-disabled 'Bluetooth disconnected' "$name"
else
    if [[ $state == Available ]]; then
        notify-send -t 1500 -i bluetooth 'Bluetooth' "Pairing with $name..."
        if ! output=$(pair_device "$mac"); then
            fail "${output:-Pairing canceled}"
        fi
    fi
    if ! output=$(btctl trust "$mac"); then
        fail "${output:-Could not trust $name}"
    fi
    notify-send -t 1500 -i bluetooth 'Bluetooth' "Connecting to $name..."
    if ! output=$(btctl connect "$mac"); then
        fail "${output:-Could not connect $name}"
    fi
    if ! btctl info "$mac" | grep -q 'Connected: yes'; then
        fail "Connection to $name did not complete. Wake the device and retry."
    fi
    notify-send -t 2000 -i bluetooth 'Bluetooth connected' "$name"
fi
