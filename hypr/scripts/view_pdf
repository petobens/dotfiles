#!/usr/bin/env bash
set -euo pipefail

pdf=$(realpath -e -- "$1")
script_dir=$(dirname "$(realpath "$0")")
clients=$(hyprctl clients -j)

# Ask each viewer for its document path; titles only contain the basename
while IFS=$'\t' read -r address pid; do
    filename=$(busctl --user --json=short get-property \
        "org.pwmt.zathura.PID-$pid" /org/pwmt/zathura \
        org.pwmt.zathura filename 2> /dev/null | jq -r '.data') || continue
    if [[ $(realpath -m -- "$filename") == "$pdf" ]]; then
        exec "$script_dir/focus_window" "$address"
    fi
done < <(jq -r '
    .[] | select(.class == "org.pwmt.zathura") | [.address, .pid] | @tsv
' <<< "$clients")

exec zathura --fork "$pdf"
