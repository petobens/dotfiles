#!/usr/bin/env bash
set -euo pipefail

layout=${1:?usage: place_window LAYOUT}

# Read the active window and its monitor geometry
read -r address monitor_x monitor_y monitor_w monitor_h < <(
    hyprctl activewindow -j | jq -r '[.address, .monitor] | @tsv' | {
        read -r address monitor
        hyprctl monitors -j | jq -r --argjson monitor "$monitor" --arg address "$address" \
            '.[] | select(.id == $monitor) |
            [$address, .x, .y, (.width / .scale | floor), (.height / .scale | floor)] |
            @tsv'
    }
)

# Map named layouts to monitor-relative thousandths
case "$layout" in
    full)
        x=0
        y=0
        w=1000
        h=1000
        ;;
    left)
        x=0
        y=0
        w=500
        h=1000
        ;;
    right)
        x=500
        y=0
        w=500
        h=1000
        ;;
    top)
        x=0
        y=0
        w=1000
        h=500
        ;;
    bottom)
        x=0
        y=500
        w=1000
        h=500
        ;;
    top-left)
        x=0
        y=0
        w=500
        h=500
        ;;
    top-right)
        x=500
        y=0
        w=500
        h=500
        ;;
    bottom-left)
        x=0
        y=500
        w=500
        h=500
        ;;
    bottom-right)
        x=500
        y=500
        w=500
        h=500
        ;;
    center)
        x=250
        y=250
        w=500
        h=500
        ;;
    rectangle)
        x=125
        y=200
        w=750
        h=600
        ;;
    dialog)
        x=330
        y=300
        w=350
        h=250
        ;;
    semi-full)
        x=10
        y=0
        w=985
        h=990
        ;;
    *)
        echo "unknown layout: $layout" >&2
        exit 2
        ;;
esac

# Relative dimensions keep layouts consistent across displays
px=$((monitor_x + monitor_w * x / 1000))
py=$((monitor_y + monitor_h * y / 1000))
pw=$((monitor_w * w / 1000))
ph=$((monitor_h * h / 1000))
window="address:$address"
hyprctl dispatch "hl.dsp.window.float({ action = 'set', window = '$window' })"
hyprctl dispatch "hl.dsp.window.resize({ x = $pw, y = $ph, window = '$window' })"
hyprctl dispatch "hl.dsp.window.move({ x = $px, y = $py, window = '$window' })"
