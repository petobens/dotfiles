# vi: ft=dosini
[main]
smart_completion = True
wider_completion_menu = False
multi_line = True
multi_line_mode = psql
destructive_warning = True
generate_aliases = False
keyword_casing = upper
case_column_headers = True
timing = True
table_format = psql
# One Dark supplies the base; [syntax_colors] applies OneDarkish overrides
syntax_style = one-dark
vi = True
on_error = STOP
row_limit = 1000
less_chatty = False
prompt = '\u@\h:\d> '
multiline_continuation_char = ''
null_string = '<null>'
enable_pager = True
keyring = True

[syntax_colors]
pygments = '#abb2bf bg:#24272e'
pygments.comment = '#5c6370 italic'
pygments.name.function = '#61afef nobold'
pygments.name.function.magic = '#61afef nobold'
pygments.name.decorator = '#528bff'
pygments.keyword.type = '#61afef'
pygments.punctuation = '#528bff'
pygments.error = '#e06c75'

[colors]
completion-menu.completion.current = 'bg:#61afef #24272e'
completion-menu.completion = 'bg:#333841 #abb2bf'
completion-menu.meta.completion.current = 'bg:#61afef #24272e'
completion-menu.meta.completion = 'bg:#333841 #abb2bf'
completion-menu.multi-column-meta = 'bg:#333841 #abb2bf'
scrollbar.arrow = 'bg:#333841 #abb2bf'
scrollbar = 'bg:#333841 #abb2bf'
selected = 'bg:#3e4452 #abb2bf'
search = 'bg:#3e4452 #e5c07b'
search.current = 'bg:#e5c07b #24272e'
bottom-toolbar = 'bg:#282c34 #abb2bf'
bottom-toolbar.off = 'bg:#282c34 #5c6370'
bottom-toolbar.on = 'bg:#282c34 #abb2bf'
bottom-toolbar.transaction.valid = 'bg:#282c34 #98c379 bold'
bottom-toolbar.transaction.failed = 'bg:#282c34 #e06c75 bold'
output.header = '#98c379 bold'
output.null = '#5c6370'

[named queries]

[alias_dsn]
