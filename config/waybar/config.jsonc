[
    {
        "output": ["eDP-1", "Virtual-1", "GWD ARZOPA 0x0965020C"],
        "modules-right": [
            "custom/docker",
            "custom/onedrive",
            "hyprland/language",
            "custom/vpn",
            "custom/wifi",
            "network#ethernet",
            "custom/bluetooth",
            "pulseaudio",
            "battery",
            "custom/no-battery",
            "clock",
            "tray",
        ],
        "include": "$HOME/.config/waybar/common.jsonc",
    },
    {
        "output": ["!eDP-1", "!Virtual-1", "!GWD ARZOPA 0x0965020C", "*"],
        "include": "$HOME/.config/waybar/common.jsonc",
    },
]
