{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "modules-left": ["custom/arch", "custom/window-count", "hyprland/window"],
    "modules-center": ["hyprland/workspaces"],
    "modules-right": [
        "custom/docker",
        "custom/onedrive",
        "hyprland/language",
        "custom/vpn",
        "network",
        "custom/bluetooth",
        "pulseaudio",
        "battery",
        "clock",
        "tray",
    ],
    "custom/arch": {
        "format": "",
        "on-click": "~/.config/hypr/scripts/session_menu",
        "tooltip": false,
    },
    "custom/window-count": {
        "exec": "~/.config/hypr/scripts/window_count",
        "interval": 1,
        "on-click": "~/.config/hypr/scripts/window_switcher current",
        "return-type": "json",
    },
    "hyprland/window": {
        "format": "{title}",
        "max-length": 30,
        "separate-outputs": true,
    },
    "hyprland/workspaces": {
        "format": "{icon} {id}",
        "format-icons": {
            "1": "󰖟",
            "2": "",
            "3": "󰝚",
            "4": "󰙀",
            "5": "󰞷",
            "6": "󰗚",
            "default": "󰙀",
        },
        "on-click": "activate",
        "sort-by": "number",
    },
    "custom/docker": {
        "exec": "~/.config/hypr/scripts/docker_status",
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/app docker",
        "return-type": "json",
    },
    "custom/onedrive": {
        "exec": "~/.config/hypr/scripts/onedrive_status",
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/app onedrive",
        "return-type": "json",
    },
    "hyprland/language": {
        "format": "{short}",
    },
    "custom/vpn": {
        "exec": "printf '󰛶'",
        "exec-if": "pgrep -x 'openconnect|openvpn|vpnc|snx'",
        "interval": 5,
    },
    "network": {
        "format-wifi": "{icon} {signalStrength}%",
        "format-ethernet": "󰈁",
        "format-disconnected": "󰖪",
        "format-icons": ["󰤟", "󰤢", "󰤥", "󰤨"],
        "on-click": "~/.config/hypr/scripts/app wifi",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}",
    },
    "custom/bluetooth": {
        "exec": "~/.config/hypr/scripts/bluetooth_status",
        "interval": 5,
        "on-click": "~/.config/hypr/scripts/app bluetooth",
        "on-click-right": "bluetoothctl info | grep -q '^Device' && bluetoothctl disconnect",
        "return-type": "json",
    },
    "pulseaudio": {
        "format": "{icon}",
        "format-icons": ["", "󰖀", "󰕾", ""],
        "format-muted": "",
        "on-click": "~/.config/hypr/scripts/app audio",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    },
    "battery": {
        "format": "{icon} {capacity}%",
        "format-charging": " {capacity}%",
        "format-full": "󰂄 100%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂"],
        "states": {
            "critical": 10,
            "warning": 25,
        },
    },
    "clock": {
        "format": "󰃰 {:%a %d %H:%M}",
        "format-alt": "󰃰 {:%A %d %b %Y %H:%M:%S}",
        "on-click": "~/.config/hypr/scripts/app calendar",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
    },
    "tray": {
        "spacing": 8,
    },
}
