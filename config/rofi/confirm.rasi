configuration {
    font: "Noto Sans 10";
    show-icons: false;
}

* {
    background: #302e2b;
    foreground: #f2f2f2;
    button-background: #292825;
    button-selected-background: #363431;
    border-color: #171717;
    selected-border-color: #61afef;
}

window {
    location: center;
    width: 240px;
    y-offset: 0px;
    padding: 12px;
    background-color: @background;
    border: 1px;
    border-color: @border-color;
    border-radius: 8px;
}

mainbox {
    spacing: 12px;
    background-color: @background;
    children: [ inputbar, listview ];
}

inputbar {
    background-color: @background;
    children: [ prompt ];
}

prompt {
    background-color: @background;
    text-color: @foreground;
    horizontal-align: 0.5;
}

listview {
    background-color: @background;
    columns: 2;
    lines: 1;
    flow: horizontal;
    fixed-columns: true;
    spacing: 6px;
}

element {
    padding: 7px 12px;
    background-color: @button-background;
    text-color: @foreground;
    border: 1px;
    border-color: @border-color;
    border-radius: 4px;
    cursor: pointer;
}

element selected {
    background-color: @button-selected-background;
    text-color: @foreground;
    border-color: @selected-border-color;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    horizontal-align: 0.5;
}
