{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoCompactWindow": 350000,
  "effortLevel": "medium",
  "includeGitInstructions": false,
  "model": "opus[1m]",
  "permissions": {
    "allow": [
      "Read",
      "Bash(stylua *)",
      "Bash(gws *)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(sudo *)"
    ]
  },
  "sandbox": {
    "enabled": true
  },
  "spinnerTipsEnabled": false,
  "statusLine": {
    "command": "~/.claude/statusline.sh",
    "type": "command"
  },
  "theme": "dark",
  "tui": "default"
}
