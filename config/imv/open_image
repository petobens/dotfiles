#!/usr/bin/env bash
set -euo pipefail

: "${imv_pid:?}"

start_directory=$HOME/Pictures
if [[ -n ${imv_current_file:-} ]]; then
    start_directory=$(dirname -- "$imv_current_file")
fi

selection_file=$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/imv-open.XXXXXX")
trap 'rm -f "$selection_file"' EXIT

# Forward the directory and chooser file through Fish's Yazi bootstrap wrapper
# shellcheck disable=SC2016
ghostty \
    --class=yazi \
    --title=yazi \
    -e fish -c 'yazi $argv' -- "$start_directory" \
    --chooser-file="$selection_file"

mapfile -t images < "$selection_file"
((${#images[@]})) || exit 0

# Load the selected image's directory and keep that image selected for browsing
index=-1
if ((${#images[@]} == 1)); then
    directory=$(dirname -- "${images[0]}")
    LC_ALL=C
    shopt -s dotglob nullglob
    index=0
    for path in "$directory"/*; do
        [[ -d $path || ! -e $path ]] && continue
        [[ ${path##*/} < ${images[0]##*/} ]] && continue
        ((index -= 1))
    done
    images=("$directory")
    imv-msg "$imv_pid" 'close all'
fi

for image in "${images[@]}"; do
    encoded=$(printf '%s' "$image" | base64 -w0)
    # imv splits commands on spaces before expanding each argument
    imv-msg "$imv_pid" \
        "open \"\$(printf\${IFS}%s\${IFS}$encoded|base64\${IFS}-d)\""
done
imv-msg "$imv_pid" "goto $index"
